# Copia este archivo como .env y llena los valores. Nunca subas el .env a GitHub.
# En Render estos mismos nombres van en Environment.

# --- El restaurante ---
# Archivo con menú, precios y sucursales (copie negocios/ejemplo.json y llénelo con datos confirmados por el cliente)
NEGOCIO=negocios/ejemplo.json

# --- Twilio (console.twilio.com > Account Info). Use una subcuenta por cliente. ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token

# true mientras pruebas con el sandbox de WhatsApp de Twilio (+1 415 523 8886).
# false cuando el número del restaurante ya esté aprobado por Meta.
TWILIO_SANDBOX=true

# Número desde el que habla el bot. En sandbox puedes dejarlo vacío. Producción: +504...
TWILIO_WHATSAPP_FROM=

# Plantilla aprobada para los avisos al dueño (Content SID, empieza con HX). Solo en producción.
TWILIO_ALERT_CONTENT_SID=

# --- A quién le llegan los pedidos ---
# Dueño: recibe todos los pedidos y los "quiero hablar con una persona".
# Cada sucursal con WhatsApp propio (campo "whatsapp" en el archivo del negocio) recibe los suyos.
OWNER_WHATSAPP=+504 9999-9999

# --- Servidor ---
PORT=3000
# URL pública del bot, sin / al final (https://mi-restaurante-bot.onrender.com). Se usa para validar la firma de Twilio.
PUBLIC_URL=
# Solo para pruebas locales sin Twilio. Nunca en producción.
SKIP_TWILIO_SIGNATURE=false
# Clave para leer los pedidos en GET /api/pedidos desde otro sistema. Pon una larga y al azar.
LEADS_TOKEN=cambia-esta-clave
# Carpeta donde se guardan pedidos.json, sessions.json y usuarios.json
DATA_DIR=./data
# Horas sin escribir para que la conversación vuelva a empezar
SESSION_TTL_HOURS=12
TZ=America/Tegucigalpa

# --- Modo IA con Claude (opcional) ---
# Con la clave, el bot entiende mensajes libres. Sin clave contesta con el menú de opciones.
# La clave se pega SOLO aquí (local) o en Render > Environment. Nunca en un chat ni en GitHub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# off = apagar el modo IA aunque haya clave
BOT_IA=
# Demostración con IA para clientiatech.com (demo.js, solo el servidor de la demo): on = activa /demo/chat
DEMO_IA=
# DEMO_ORIGENES=https://clientiatech.com,https://www.clientiatech.com
# DEMO_LIMITE_VISITANTE=15   mensajes por visitante cada 10 minutos
# DEMO_LIMITE_DIA=400        respuestas con IA por día en todo el sitio

# --- Panel del dueño en /panel (correo y contraseña) ---
# PANEL_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PANEL_SECRET=
# Personas autorizadas: npm run usuario -- agregar correo "Nombre"  (o las líneas de: npm run usuario -- linea correo "Nombre")
PANEL_USUARIOS=

# --- Pago con tarjeta (opcional) ---
# Cuenta de comercio DEL RESTAURANTE en la pasarela (el dinero cae en su banco). Hoy: tilopay.
# Con esto cada pedido que se paga antes lleva su propio link y, si el pago sale bien, pasa solo a cocina.
# Necesita PUBLIC_URL para recibir el aviso de la pasarela.
PAGOS_PASARELA=
# Tilopay > Admin > Tilopay Checkout: usuario y contraseña del API, y la key de la integración
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_KEY=
PAGOS_MONEDA=HNL
# Firma los links de aviso de pago. Vacío = usa PANEL_SECRET.
PAGOS_SECRET=

# --- Freno contra mensajes en masa (opcional) ---
# Mensajes que acepta de un mismo número cada 10 minutos; después le avisa y no contesta hasta que pase.
LIMITE_MENSAJES=40
# Respuestas con IA por número al día; después contesta con el menú (no gasta Claude).
LIMITE_IA_DIA=80
