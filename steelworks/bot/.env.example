# Copia este archivo como .env y llena los valores. Nunca subas el .env a GitHub.
# En Render estos mismos nombres van en Environment.

# --- Twilio (console.twilio.com > Account Info) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token

# true mientras pruebas con el sandbox de WhatsApp de Twilio (+1 415 523 8886).
# false cuando ya tengas el número propio de Steel Works aprobado por Meta.
TWILIO_SANDBOX=true

# Número desde el que habla el bot. En sandbox puedes dejarlo vacío.
# Producción: el número de WhatsApp Business de Steel Works, por ejemplo +50432658800
TWILIO_WHATSAPP_FROM=

# Plantilla aprobada para los avisos (Content SID, empieza con HX). Solo en producción.
# Sin plantilla los avisos solo llegan si el dueño le escribió al bot en las últimas 24 horas.
TWILIO_ALERT_CONTENT_SID=

# --- A quién le llegan las fichas ---
# Dueño: recibe todas las fichas y los "quiero hablar con una persona".
OWNER_WHATSAPP=+504 9999-9999
# Sucursales: si tienen su propio WhatsApp, reciben las fichas de su zona (opcional).
BRANCH_TGU_WHATSAPP=
BRANCH_SPS_WHATSAPP=

# --- Llamadas (opcional, ver LLAMADAS.md) ---
# Teléfono al que se pasa la llamada cuando el cliente pide una persona. Vacío = se cuelga y se avisa al dueño.
VOICE_TRANSFER_TGU=
VOICE_TRANSFER_SPS=
VOICE_LANG=es-MX
VOICE_TTS=Polly.Mia
VOICE_SPEECH_MODEL=

# --- Servidor ---
PORT=3000
# URL pública del bot, sin / al final (https://steelworks-bot.onrender.com). Se usa para validar la firma de Twilio.
PUBLIC_URL=
# Solo para pruebas locales sin Twilio. Nunca en producción.
SKIP_TWILIO_SIGNATURE=false
# Clave para leer las fichas en GET /leads (el panel del dueño). Pon una larga y al azar.
LEADS_TOKEN=cambia-esta-clave
# Carpeta donde se guardan leads.json y sessions.json
DATA_DIR=./data
# Horas sin escribir para que la conversación vuelva a empezar
SESSION_TTL_HOURS=24
# Hora de Honduras para los días de visita
TZ=America/Tegucigalpa
# Opcional: carpeta pública con las fotos de trabajos (obra-cerco.jpg, ...) para mandarlas al elegir estilo
FOTOS_URL=
